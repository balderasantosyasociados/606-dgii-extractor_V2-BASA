  <script type="text/javascript">

    function GETDetailVal(sec) {
      $.ajax({
        type: "POST",
        contentType: "application/json",
        data: "{'pSecuencia':" + sec + "}",
        dataType: "json",
        url: "Envios606.aspx/GETDetailVal",
        success: function (data) {
          var parsed = JSON.parse(data.d);
          var myDataTable = $("#my-datatable").html("<table class='table' width='100%'><thead><tr class='success'><th>LINEA</th><th>DESCRIPCION</th><th>DATO VALIDADO</th></tr></thead><tbody></tbody></table>");
          $("#myModalLabel").html("Detalle Validación");
          $("table", myDataTable).DataTable({
            retrieve: true,
            dom: 'Bfrtip',
            buttons: ['excel', 'print'],
            "lengthMenu": [[10], [10]],
            "aaData": parsed,
            "aoColumns": [
          { "mData": "LINEA_NUMERO" },
          { "mData": "DESCRIPCION_ERROR" },
          { "mData": "DATO_VALIDADO" }
            ]
          });

          $('#myModal').modal();
        },
        error: function (data) {
          alert('ha ocurrido un error');
        }
      });
    }
 
    function GETDetailResumen(sec) {
      $.ajax({
        type: "POST",
        contentType: "application/json",
        data: "{'pSecuencia':" + sec + "}",
        dataType: "json",
        url: "Envios606.aspx/GETDetailResumen",
        success: function (data) {
          $("#myModalLabel").html("Resúmen del Envío");
          $("#my-datatable").html(data.d);
          $('#myModal').modal();
        },
        error: function (data) {
          alert('ha ocurrido un error');
        }
      });
    }
            
  </script>
