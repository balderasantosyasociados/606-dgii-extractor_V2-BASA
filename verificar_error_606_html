  <script type="text/javascript">
    var Score = parseFloat(5.00);

    $(document).ready(function () {
      for (i = 0; i < 3; i++) {
        $("#alert").fadeOut(500);
        $("#alert").fadeIn(1000);
      }

      $(".linkScoring").on('click', function (e) {
        $.ajax({
          type: "POST",
          url: "/OFV/Home.aspx/CargarPaginaScoring",
          contentType: "application/json; charset=utf-8",
          dataType: "json",
          success: function (r) {
            if (r.d.startsWith("Error:")) {
              // Maneja el error de manera adecuada, por ejemplo, mostrando un mensaje al usuario
              alert(r.d);
            } else {
              // Abre la URL en una nueva pestaña
              window.open(r.d.toString(), '_blank');
            }
          },
          error: function (xhr, status, error) {
            // Maneja errores en la solicitud AJAX
            console.error("Error en la solicitud AJAX: " + status + " - " + error);
            alert("Ocurrió un error al intentar cargar la página de scoring.");
          }
        });
      });

      if (Score > 0) {
        $(".divJuridico_Rating").attr("hidden", false)
        $(".divScores").attr('style', 'width:' + CalcularWidth(Score, 160));
      }
      else {
        $(".divJuridico_Rating").hide();
      }
    });


    function CalcularWidth(porcentaje, valorAncho) {
      var valor = parseFloat(porcentaje);
      var width = "0px";
      if (porcentaje != null) {
        var rating = (valorAncho * valor) / 5;
        width = `${rating}px`;
      }
      return width;
    }

  </script>

